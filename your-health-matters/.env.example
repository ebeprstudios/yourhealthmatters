# Your Health Guide™ — environment variables
#
# Copy this file to .env.local for local dev. In production, add these in
# Vercel → Project → Settings → Environment Variables (Production + Preview).

# ── Anthropic / Dr. Vera chat ────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ── Resend — email delivery ──────────────────────────────────────────
# Get the API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Branded sender. The domain must be verified at https://resend.com/domains
# (SPF + DKIM + return-path records on the sending domain).
RESEND_FROM_EMAIL="Dr. Vera <hello@yourhealthguide.co>"

# Lead-magnet audience. Create at https://resend.com/audiences →
# "Create Audience" → name it "Guide Subscribers" → copy the ID here.
RESEND_GUIDE_AUDIENCE_ID=

# Weekly newsletter audience (optional — newsletter still works without it,
# but adding contacts here keeps the two streams properly separated).
RESEND_NEWSLETTER_AUDIENCE_ID=

# Internal notification inbox for new subscribers / leads.
NEWSLETTER_TO_EMAIL=hello@ebeprstudios.com

# Legacy alias — keep equal to RESEND_FROM_EMAIL for backward compat
# with the existing newsletter route. New code should read RESEND_FROM_EMAIL.
NEWSLETTER_FROM_EMAIL="Dr. Vera <hello@yourhealthguide.co>"
